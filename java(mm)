import java.util.*;

class Data
{
    protected float r;

    public void read(float x)
    {
        r = x;
    }
}

class Area extends Data
{
    protected float area;

    public void calculate()
    {
        area = 3.14f * r * r;
    }

    public void display()
    {
        System.out.println("Area = " + area);
    }
}

class Volume extends Area
{
    private float volume;

    public void compute()
    {
        volume = area * r * 4 / 3;
    }

    public void display()
    {
        System.out.println("Volume = " + volume);
    }
}

class practical2b
{
    public static void main(String args[])
    {
        float x;

        Scanner sc = new Scanner(System.in);

        System.out.println("Enter the radius:");
        x = sc.nextFloat();

        Volume a = new Volume();

        a.read(x);
        a.calculate();
        a.compute();
        a.display();
    }
}





import java.awt.*;
import java.awt.event.*;
import javax.swing.*;

public class practical9b extends JFrame implements ActionListener
{
    JPasswordField passwordfield;
    JButton toggleButton;
    boolean isVisible = false;

    public practical9b()
    {
        setTitle("Show/Hide Password");
        setSize(350, 150);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(new FlowLayout());

        JLabel label = new JLabel("Password:");

        passwordfield = new JPasswordField(15);
        passwordfield.setEchoChar('*');

        toggleButton = new JButton("Show Password");
        toggleButton.addActionListener(this);

        add(label);
        add(passwordfield);
        add(toggleButton);

        setVisible(true);
    }

    @Override
    public void actionPerformed(ActionEvent e)
    {
        if (!isVisible)
        {
            passwordfield.setEchoChar((char) 0);
            toggleButton.setText("Hide Password");
            isVisible = true;
        }
        else
        {
            passwordfield.setEchoChar('*');
            toggleButton.setText("Show Password");
            isVisible = false;
        }
    }

    public static void main(String args[])
    {
        new practical9b();
    }
}
