import java.util.*;

class Circle
{
    float r, area;

    Circle()
    {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter Radius:");
        r = sc.nextFloat();
    }

    void calculate()
    {
        area = 3.14f * r * r;
    }

    void display()
    {
        System.out.println("Area = " + area);
    }

    public static void main(String args[])
    {
        Circle c = new Circle();
        c.calculate();
        c.display();
    }
}
